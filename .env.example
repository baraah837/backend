# ─── Server ───────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── PostgreSQL Database ───────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=misfar_db
DB_USER=postgres
DB_PASSWORD=your_password_here

# ─── JWT ──────────────────────────────────────────────
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your_refresh_token_secret_here
JWT_REFRESH_EXPIRES_IN=30d

# ─── File Uploads ─────────────────────────────────────
UPLOAD_PATH=./uploads
MAX_FILE_SIZE_MB=10

# ─── Email (Notifications) ────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_here
EMAIL_FROM=noreply@misfar.om

# ─── Frontend URL (CORS) ──────────────────────────────
CLIENT_URL=http://localhost:3000

# ─── AI / Recommendation ─────────────────────────────
AI_RECOMMENDATION_WEIGHT_RATING=0.4
AI_RECOMMENDATION_WEIGHT_POPULARITY=0.3
AI_RECOMMENDATION_WEIGHT_INTERESTS=0.3
